# Copia de ejemplo: scripts/setup.sh crea .env (modo 0600) con contraseñas aleatorias. No subas .env.
MQTT_HASIM_PASSWORD=cambiame
MQTT_HA_PASSWORD=cambiame
# Usuario de Home Assistant que crea el onboarding automático (cámbialo).
HA_USERNAME=hasim
HA_PASSWORD=hasim-cambiame
# Token del laboratorio: la app lo pide en Ajustes → Laboratorio y el orquestador lo exige.
# setup.sh genera uno aleatorio (64 caracteres hexadecimales).
LAB_TOKEN=cambia-este-token-por-uno-aleatorio
# Interfaz de Caddy (8080): 127.0.0.1 = solo este PC (por defecto); 0.0.0.0 = también la LAN.
LAB_BIND=127.0.0.1
# Orígenes extra de la app en la LAN con nombre (separados por comas), p. ej. http://mipc.local:8080
#ALLOWED_ORIGINS=
# Perfil opcional con el socket de Docker (restaurar snapshots): setup.sh --docker añade
#COMPOSE_FILE=docker-compose.yml:docker-compose.docker.yml
# Perfiles de las vías reales (E2): setup.sh --zwave / --esphome / --all los escribe aquí.
#COMPOSE_PROFILES=zwave,esphome
# ESPHome sin cifrado (por defecto cada nodo usa Noise con su clave en .secrets/esphome-nodes.json):
#ESPHOME_ENCRYPTION=0
# Cada cuántos segundos despiertan los nodos Z-Wave a pilas (Wake Up):
#ZWAVE_WAKEUP_S=120
TZ=Europe/Madrid
